     ]
    }
   ],
   "source": [
    "tuple1 = (1, 2, 3, 3, 5)\n",
    "\n",
    "a,b, c, d, e = tuple1\n",
    "\n",
    "print(\"a :\", a,\"b :\", b, \"c :\", c, \"d :\", d, \"e :\", e)\n",
    "print(tuple1.count(3))\n",
    "print(tuple1.index(5))"
   ]
